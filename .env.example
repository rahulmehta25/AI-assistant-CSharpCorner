# =====================================================
# AI Career Assistant API - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =====================================================

# -----------------------------------------------------
# APPLICATION
# -----------------------------------------------------
APP_NAME=AI Career Assistant API
APP_VERSION=2.0.0

# Environment mode: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json (production) or text (development)
LOG_FORMAT=text

# Optional log file path
LOG_FILE=

# -----------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------
# PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=career_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Full database URL (overrides individual settings above)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_assistant

# Legacy SQLite support (for local development without Docker)
DATABASE_TYPE=sqlite
DATABASE_PATH=data/users.db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------
# REDIS
# -----------------------------------------------------
# Redis connection settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Full Redis URL (overrides individual settings above)
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Cache TTL settings (in seconds)
CACHE_TTL_SECONDS=3600
CACHE_ROADMAP_TTL=86400
CACHE_RESUME_TTL=3600

# Conversation memory settings
CONVERSATION_MAX_MESSAGES=50
CONVERSATION_SUMMARY_THRESHOLD=20

# -----------------------------------------------------
# AI/ML SERVICES
# -----------------------------------------------------
# OpenAI API key (required for AI features)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model settings
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# Alternative AI providers (optional)
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# -----------------------------------------------------
# SECURITY
# -----------------------------------------------------
# Secret key for JWT tokens and session encryption
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-character-hex-string

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=20

# -----------------------------------------------------
# API SERVER
# -----------------------------------------------------
# Backend API settings
HOST=0.0.0.0
PORT=8001
WORKERS=4

# Frontend settings
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8001

# -----------------------------------------------------
# JOB SCRAPING
# -----------------------------------------------------
# Job board API keys (for live job scraping)
INDEED_API_KEY=your_indeed_api_key_here
LINKEDIN_API_KEY=your_linkedin_api_key_here
# GLASSDOOR_API_KEY=

# Scraping configuration
SCRAPING_MAX_RETRIES=3
SCRAPING_TIMEOUT=30
SCRAPING_CACHE_DURATION=86400

# Data paths
CAREERS_DATA_PATH=data/careers
ROADMAP_TEMPLATES_PATH=data/roadmap_templates
EDUCATION_PATHWAYS_PATH=data/education_pathways

# -----------------------------------------------------
# EXTERNAL SERVICES
# -----------------------------------------------------
# Email service (for notifications)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@localhost

# File storage (for resumes, etc.)
# Options: local, s3, gcs
STORAGE_BACKEND=local
STORAGE_PATH=./uploads

# AWS S3 (if STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=

# -----------------------------------------------------
# MONITORING
# -----------------------------------------------------
# Prometheus metrics
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001

# Sentry (error tracking)
# SENTRY_DSN=

# -----------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------
# Enable/disable specific features
FEATURE_AI_CHAT=true
FEATURE_JOB_SCRAPING=true
FEATURE_RESUME_ANALYSIS=true
FEATURE_SKILL_ASSESSMENT=true

# -----------------------------------------------------
# DEVELOPMENT
# -----------------------------------------------------
# Enable debug mode (development only!)
DEBUG=false

# Enable hot reload
HOT_RELOAD=true

# Test database URL
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_assistant_test

# -----------------------------------------------------
# DOCKER
# -----------------------------------------------------
# Docker Compose project name
COMPOSE_PROJECT_NAME=career_assistant

# Image tags
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
